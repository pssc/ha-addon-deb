#!/usr/bin/with-contenv bashio
# ==============================================================================
# Home Assistant Community Add-on: SSH & Web Terminal
# Runs the ttyd daemon
# ==============================================================================
declare ttyd_command
declare -a options
declare ingress_port
declare ttyd_ping_interval

bashio::log.info 'Starting the ttyd daemon...'

# Set daemon debug level
if bashio::debug; then
    options+=(-d7)
else
    options+=(-d1)
fi

# Listen on Supervisor interface only
options+=(-i hassio)

# Get assigned Ingress port
ingress_port=$(bashio::addon.ingress_port)
options+=(-p "${ingress_port}")
# Keep idle terminal sessions alive through Ingress; configurable in the add-on options.
ttyd_ping_interval=$(bashio::config 'ttyd_ping_interval')
options+=(-P "${ttyd_ping_interval}")

ttyd_command=(tmux -u new -A -s homeassistant zsh -l)
if ! bashio::config.true "zsh"; then
    ttyd_command=(tmux -u new -A -s homeassistant bash -l)
fi

# Derived add-ons can provide a command override without replacing this service script.
if [[ -f /etc/ttyd/command ]]; then
    # The override must assign the ttyd_command array.
    # shellcheck source=/dev/null
    source /etc/ttyd/command
fi

# Change working directory
cd /root || bashio::exit.nok 'Unable to change working directory'

# Set environment so that we know if we're running under ttyd
export TTYD=1

# Run the ttyd daemon
exec ttyd "${options[@]}" "${ttyd_command[@]}"
